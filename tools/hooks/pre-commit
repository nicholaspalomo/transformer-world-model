#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook — Automatic formatting, Google3 linting & IFTTT validation
# ==============================================================================
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# Add local virtual environment to PATH if present
if [ -d "$REPO_ROOT/../venv/bin" ]; then
    export PATH="$REPO_ROOT/../venv/bin:$PATH"
elif [ -d "$REPO_ROOT/.venv/bin" ]; then
    export PATH="$REPO_ROOT/.venv/bin:$PATH"
fi

echo "🔍 Pre-Commit Hook: Running IFTTT cross-file directive linter..."
if [ -f "tools/hooks/check_ifttt.py" ]; then
    python3 tools/hooks/check_ifttt.py
fi

echo "🔍 Pre-Commit Hook: Running code formatters and Google3 linters..."
if command -v ruff >/dev/null 2>&1 && command -v black >/dev/null 2>&1; then
    make format
    make lint
elif command -v docker >/dev/null 2>&1 && docker ps | grep -q "transformer_world_model_dev"; then
    docker exec transformer_world_model_dev make format
    docker exec transformer_world_model_dev make lint
else
    echo "⚠️ Warning: 'ruff'/'black' not found in PATH and container is offline. Running check_ifttt only."
fi

# Automatically stage any formatting changes to files that were staged for commit
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)

if [ -n "$STAGED_FILES" ]; then
    FORMATTED_COUNT=0
    for file in $STAGED_FILES; do
        if [ -f "$file" ] && [ -n "$(git status --porcelain "$file")" ]; then
            git add "$file"
            FORMATTED_COUNT=$((FORMATTED_COUNT + 1))
        fi
    done
    if [ "$FORMATTED_COUNT" -gt 0 ]; then
        echo "✨ Auto-formatted and staged $FORMATTED_COUNT file(s) before commit."
    fi
fi

echo "✅ Pre-commit checks completed successfully."
