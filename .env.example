# ==============================================================================
# Host-side overrides for docker-compose.yml. Copy to `.env` and edit:
#
#     make env          # or:  cp .env.example .env
#
# Docker Compose reads `.env` from this directory automatically, and the Makefile
# includes it too so that the URLs it prints stay in step with what was published.
# `.env` is gitignored -- these are machine-local choices, not project settings.
#
# Nothing here is required. Every value below is the default that already applies.
# Change something only when it collides with another stack on this machine.
# ==============================================================================

# ------------------------------------------------------------------ namespacing
# Compose derives container, network, image and volume names from the project name.
# The default is `twm`, so this stack owns `twm-twm_dev-1`, `twm_default`,
# `twm_twm-home`, and nothing else on the machine answers to those names.
#
# Set this if you run TWO checkouts of this repo at once (e.g. one per branch):
# give the second one its own name and the two stacks stay completely separate --
# separate containers, separate network, separate caches.
#COMPOSE_PROJECT_NAME=twm

# --------------------------------------------------------------------- networking
# Only the HOST side of each port mapping is configurable. The container side is
# fixed: scripts/start_vnc.sh binds 5900/6080 inside the container and `make
# tensorboard` runs `tensorboard --port 6006` there. Those are internal and must
# not move.
#
# The defaults below deliberately avoid the canonical 5900/5901/6080/6006/8888 that
# most VNC and notebook containers grab, so a fresh `make docker-up` does not fight
# a stack that is already running. Check what is taken with:
#
#     make ports
#     ss -tulpn | grep -E ':(5915|6095|6016|8898)'
#
#HOST_VNC_PORT=5915
#HOST_NOVNC_PORT=6095
#HOST_TENSORBOARD_PORT=6016
#HOST_JUPYTER_PORT=8898

# Interface the published ports bind to. The VNC server runs with `-nopw`, so the
# default keeps it reachable only from this machine. Set 0.0.0.0 to expose the
# desktop to the LAN -- only do that on a network you trust.
#BIND_ADDR=127.0.0.1

# ------------------------------------------------------------------- resources
# Ceiling on what this container may take from a shared machine. XLA's CPU backend
# otherwise runs one thread per host core and the container's memory is unbounded.
#TWM_CPUS=8
#TWM_MEM=24g

# ------------------------------------------------------------------------ display
# X display number and framebuffer size used inside the container. The display
# lives in the container's own /tmp, so it cannot collide with the host's X server
# or with another container -- change it only if you want to.
#VNC_DISPLAY=:1
#VNC_RESOLUTION=1920x1080

# --------------------------------------------------------------------- host creds
# Optional: the host git identity and SSH keys are mounted read-only so commits and
# `git push` work from inside the container. The Makefile fills these in and falls
# back to an empty stand-in when the host has no ~/.gitconfig or ~/.ssh, which keeps
# Docker from creating an empty directory at those paths on the host.
#HOST_GITCONFIG=/dev/null
#HOST_SSH_DIR=./docker/empty

# ---------------------------------------------------------------------- platform
#DOCKER_PLATFORM=linux/amd64
