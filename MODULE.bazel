module(
    name = "transformer_world_model",
    version = "0.1.0",
)

# Bazel standard rules
bazel_dep(name = "rules_python", version = "0.31.0")

# LINT.IfChange(dependencies)
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_deps",
    python_version = "3.10",
    requirements_lock = "//:pyproject.toml",
)
use_repo(pip, "pip_deps")
# LINT.ThenChange(//pyproject.toml:dependencies)
