load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "env_test",
    srcs = ["env_test.py"],
    deps = [
        "//twm:envs",
        "//twm:utils",
    ],
)

py_test(
    name = "model_test",
    srcs = ["model_test.py"],
    deps = ["//twm:models"],
)

py_test(
    name = "mppi_test",
    srcs = ["mppi_test.py"],
    deps = [
        "//twm:models",
        "//twm:planner",
    ],
)

# This file had no Bazel target and its name does not match the `*_test.py`
# discovery pattern the Makefile and CI used, so the GRPO/diffusion suite -- the
# largest test file in the repo -- ran nowhere at all.
py_test(
    name = "diffusion_grpo_test",
    srcs = ["test_diffusion_grpo.py"],
    main = "test_diffusion_grpo.py",
    deps = [
        "//twm:algorithms",
        "//twm:envs",
        "//twm:models",
        "//twm:utils",
    ],
)

py_test(
    name = "checkpoint_test",
    srcs = ["checkpoint_test.py"],
    deps = [
        "//twm:models",
        "//twm:utils",
    ],
)

